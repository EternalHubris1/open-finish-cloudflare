{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:safe": "tsx src/scripts/verify-migration-safety.ts && tsx src/scripts/migrate.ts",
    "snapshot:data": "tsx src/scripts/snapshot-data-shape.ts",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "clear-demo-data": "tsx src/scripts/clear-demo-data.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "catalog:"
  }
}
